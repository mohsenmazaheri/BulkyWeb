# Copy this file to .env (which git ignores) and choose your own values.
# Avoid the characters ; and " in passwords: they would break the connection string.

DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
# The first admin account (admin@bulky.com) is created with this password on the first start
ADMIN_PASSWORD=Change-Me-Admin1!

# Optional: Stripe test keys for checkout (README, step 4)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: your domain on a real server, e.g. mybookshop.com
ALLOWED_HOSTS=*
